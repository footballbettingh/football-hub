# Copy to .env and fill in. .env is gitignored; this file is not.

# https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=

# https://the-odds-api.com/
ODDS_API_KEY=

# --- optional tuning (defaults in config.py) ---
ODDS_API_MIN_CREDITS=50
DATA_DIR=data

# --- Telegram notifications (optional) ---
# Token from @BotFather. Chat id from: python fb.py telegram --whoami
# For a channel the bot must be an ADMINISTRATOR; the id starts with -100.
# Several destinations: comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
