__pycache__/
*.pyc
.pytest_cache/

# Secrets.
.env

# Fetched and derived. Rebuild with the buttons, or `python fb.py full-refresh`.
# `data/*` rather than `data/`: git will not re-include a file whose parent
# directory is excluded, so the two negations below were silently dead and the
# one irreplaceable file in the project was not being tracked at all.
data/*
site/
reports/

# ...except the one file that cannot be rebuilt. Every other artifact here is
# derived from data that can be fetched again; the ledger is a record of what
# was picked BEFORE each match, and once lost there is no honest way to
# reconstruct it.
!data/best_picks.csv
!data/best_accas.csv

# The price files are derived and normally ignored, but a set of them was
# force-added once as a cold-start seed: a runner with no cache has no prices,
# and therefore no fixture list and no card, and the month's Odds API credits
# were already spent. They go stale on their own — the newest `fetched_at`
# wins — and can be dropped with `git rm --cached data/odds_*.csv` once a
# fetch has run against a fresh quota.

# Unattended run logs.
logs/

# Kept on disk, deliberately out of the repository.
NEXT-STEPS.md
.env.example
Football Betting Hub Design palette/
